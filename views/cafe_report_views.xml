<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Profit analysis (POS order lines) -->
    <record id="cafe_profit_view_pivot" model="ir.ui.view">
        <field name="name">pos.order.line.cafe.pivot</field>
        <field name="model">pos.order.line</field>
        <field name="arch" type="xml">
            <pivot string="Sales &amp; Profit">
                <field name="product_id" type="row"/>
                <field name="create_date" interval="month" type="col"/>
                <field name="qty" type="measure"/>
                <field name="price_subtotal" type="measure"/>
                <field name="cafe_cost" type="measure"/>
                <field name="cafe_profit" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="cafe_profit_view_graph" model="ir.ui.view">
        <field name="name">pos.order.line.cafe.graph</field>
        <field name="model">pos.order.line</field>
        <field name="arch" type="xml">
            <graph string="Profit by Product" type="bar">
                <field name="product_id"/>
                <field name="cafe_profit" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="cafe_profit_action" model="ir.actions.act_window">
        <field name="name">Sales &amp; Profit</field>
        <field name="res_model">pos.order.line</field>
        <field name="view_mode">pivot,graph</field>
        <field name="domain">[('order_id.state', 'in', ('paid', 'done', 'invoiced'))]</field>
    </record>

    <!-- Ingredient consumption (stock moves created by POS sales) -->
    <record id="cafe_consumption_view_pivot" model="ir.ui.view">
        <field name="name">stock.move.cafe.pivot</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <pivot string="Ingredient Consumption">
                <field name="product_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="product_qty" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="cafe_consumption_view_graph" model="ir.ui.view">
        <field name="name">stock.move.cafe.graph</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <graph string="Ingredient Consumption" type="bar">
                <field name="product_id"/>
                <field name="product_qty" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="cafe_consumption_action" model="ir.actions.act_window">
        <field name="name">Ingredient Consumption</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">pivot,graph</field>
        <field name="domain">[('cafe_pos_order_id', '!=', False), ('state', '=', 'done')]</field>
    </record>

    <!-- Waste analysis -->
    <record id="cafe_waste_report_action" model="ir.actions.act_window">
        <field name="name">Waste Analysis</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">pivot,graph</field>
        <field name="domain">[('cafe_waste_id', '!=', False), ('state', '=', 'done')]</field>
    </record>
</odoo>
