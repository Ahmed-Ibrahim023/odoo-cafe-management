<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cafe_ingredient_view_tree" model="ir.ui.view">
        <field name="name">cafe.ingredient.tree</field>
        <field name="model">cafe.ingredient</field>
        <field name="arch" type="xml">
            <tree decoration-danger="is_low_stock">
                <field name="name"/>
                <field name="product_id"/>
                <field name="qty_available"/>
                <field name="uom_id"/>
                <field name="min_qty"/>
                <field name="standard_price"/>
                <field name="is_low_stock" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="cafe_ingredient_view_form" model="ir.ui.view">
        <field name="name">cafe.ingredient.form</field>
        <field name="model">cafe.ingredient</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Low Stock" bg_color="text-bg-danger" invisible="not is_low_stock"/>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Coffee Beans"/></h1></div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="uom_id"/>
                            <field name="standard_price"/>
                        </group>
                        <group>
                            <field name="qty_available"/>
                            <field name="min_qty"/>
                            <field name="is_low_stock" invisible="1"/>
                            <field name="active" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="cafe_ingredient_view_search" model="ir.ui.view">
        <field name="name">cafe.ingredient.search</field>
        <field name="model">cafe.ingredient</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="cafe_ingredient_action" model="ir.actions.act_window">
        <field name="name">Ingredients</field>
        <field name="res_model">cafe.ingredient</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
