<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cafe_recipe_view_tree" model="ir.ui.view">
        <field name="name">cafe.recipe.tree</field>
        <field name="model">cafe.recipe</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="product_tmpl_id"/>
                <field name="product_id" optional="show"/>
                <field name="price"/>
                <field name="cost"/>
                <field name="margin"/>
                <field name="margin_percent" widget="percentage" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="cafe_recipe_view_form" model="ir.ui.view">
        <field name="name">cafe.recipe.form</field>
        <field name="model">cafe.recipe</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="product_tmpl_id" options="{'no_create': True}"/>
                            <field name="product_id" options="{'no_create': True}"/>
                            <field name="yield_qty"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="price"/>
                            <field name="cost"/>
                            <field name="margin"/>
                            <field name="margin_percent"/>
                            <field name="active" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ingredients" name="ingredients">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="uom_category_id" column_invisible="1"/>
                                    <field name="ingredient_id" options="{'no_create': True}"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="cost" sum="Total"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes"><field name="note"/></page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="cafe_recipe_view_search" model="ir.ui.view">
        <field name="name">cafe.recipe.search</field>
        <field name="model">cafe.recipe</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_tmpl_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="cafe_recipe_action" model="ir.actions.act_window">
        <field name="name">Recipes</field>
        <field name="res_model">cafe.recipe</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
