<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cafe_waste_view_tree" model="ir.ui.view">
        <field name="name">cafe.waste.tree</field>
        <field name="model">cafe.waste</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date"/>
                <field name="location_id"/>
                <field name="reason"/>
                <field name="total_cost" sum="Total"/>
                <field name="state"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="cafe_waste_view_form" model="ir.ui.view">
        <field name="name">cafe.waste.form</field>
        <field name="model">cafe.waste</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="date" readonly="state == 'done'"/>
                            <field name="location_id" readonly="state == 'done'"/>
                            <field name="reason" readonly="state == 'done'"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_cost"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state == 'done'">
                        <tree editable="bottom">
                            <field name="uom_category_id" column_invisible="1"/>
                            <field name="ingredient_id" options="{'no_create': True}"/>
                            <field name="quantity"/>
                            <field name="uom_id"/>
                            <field name="cost" sum="Total"/>
                        </tree>
                    </field>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="cafe_waste_action" model="ir.actions.act_window">
        <field name="name">Waste</field>
        <field name="res_model">cafe.waste</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
