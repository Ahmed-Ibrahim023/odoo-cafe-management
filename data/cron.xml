<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_cafe_low_stock" model="ir.cron">
        <field name="name">Cafe: low stock alerts</field>
        <field name="model_id" ref="model_cafe_ingredient"/>
        <field name="state">code</field>
        <field name="code">model._cron_low_stock_alert()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>
    <record id="cron_cafe_retry_failed" model="ir.cron">
        <field name="name">Cafe: retry failed ingredient deductions</field>
        <field name="model_id" ref="point_of_sale.model_pos_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_cafe_retry_failed()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>
</odoo>
