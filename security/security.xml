<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_cafe" model="ir.module.category">
        <field name="name">Cafe</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_cafe_cashier" model="res.groups">
        <field name="name">Cashier</field>
        <field name="category_id" ref="module_category_cafe"/>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>
    <record id="group_cafe_barista" model="res.groups">
        <field name="name">Barista / Kitchen</field>
        <field name="category_id" ref="module_category_cafe"/>
    </record>
    <record id="group_cafe_storekeeper" model="res.groups">
        <field name="name">Storekeeper</field>
        <field name="category_id" ref="module_category_cafe"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="group_cafe_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_cafe"/>
        <field name="implied_ids" eval="[
            (4, ref('group_cafe_cashier')), (4, ref('group_cafe_barista')),
            (4, ref('group_cafe_storekeeper')), (4, ref('point_of_sale.group_pos_manager')),
            (4, ref('stock.group_stock_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Multi-company rules -->
    <record id="rule_cafe_ingredient_company" model="ir.rule">
        <field name="name">Cafe ingredient: multi-company</field>
        <field name="model_id" ref="model_cafe_ingredient"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_cafe_recipe_company" model="ir.rule">
        <field name="name">Cafe recipe: multi-company</field>
        <field name="model_id" ref="model_cafe_recipe"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_cafe_kitchen_company" model="ir.rule">
        <field name="name">Cafe kitchen order: multi-company</field>
        <field name="model_id" ref="model_cafe_kitchen_order"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_cafe_waste_company" model="ir.rule">
        <field name="name">Cafe waste: multi-company</field>
        <field name="model_id" ref="model_cafe_waste"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
