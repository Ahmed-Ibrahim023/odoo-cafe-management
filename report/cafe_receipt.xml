<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_cafe_receipt" model="report.paperformat">
        <field name="name">Cafe Receipt 80mm</field>
        <field name="format">custom</field>
        <field name="page_height">250</field>
        <field name="page_width">80</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">3</field>
        <field name="margin_left">3</field>
        <field name="margin_right">3</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_cafe_receipt" model="ir.actions.report">
        <field name="name">Cafe Receipt</field>
        <field name="model">pos.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cafe_management.report_cafe_receipt</field>
        <field name="report_file">cafe_management.report_cafe_receipt</field>
        <field name="print_report_name">'Receipt - %s' % object.name</field>
        <field name="paperformat_id" ref="paperformat_cafe_receipt"/>
        <field name="binding_model_id" ref="point_of_sale.model_pos_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_cafe_receipt">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="font-family: monospace; font-size: 11px;">
                    <div class="text-center">
                        <strong style="font-size: 15px;" t-esc="o.company_id.name"/><br/>
                        <span t-if="o.company_id.phone" t-esc="o.company_id.phone"/>
                    </div>
                    <hr/>
                    <div>Order: <span t-esc="o.pos_reference or o.name"/></div>
                    <div>Date: <span t-field="o.date_order"/></div>
                    <div t-if="o.cafe_kitchen_order_id" style="font-size: 16px; font-weight: bold;">Kitchen Ticket: <span t-esc="o.cafe_kitchen_order_id.kitchen_ticket"/></div>
                    <div>Cashier: <span t-esc="o.user_id.name"/></div>
                    <hr/>
                    <table style="width: 100%;">
                        <t t-foreach="o.lines" t-as="l">
                            <tr>
                                <td><span t-esc="l.full_product_name or l.product_id.display_name"/></td>
                                <td class="text-end" style="white-space: nowrap;">
                                    <span t-esc="'%g' % l.qty"/> x
                                    <span t-field="l.price_unit"/>
                                </td>
                            </tr>
                            <tr t-if="l.discount">
                                <td colspan="2">&#160;&#160;Discount <span t-esc="'%g' % l.discount"/>%</td>
                            </tr>
                            <tr t-if="l.customer_note">
                                <td colspan="2">&#160;&#160;<i t-esc="l.customer_note"/></td>
                            </tr>
                        </t>
                    </table>
                    <hr/>
                    <table style="width: 100%;">
                        <tr><td>Tax</td>
                            <td class="text-end"><span t-esc="o.amount_tax" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td></tr>
                        <tr><td><strong>TOTAL</strong></td>
                            <td class="text-end"><strong t-esc="o.amount_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td></tr>
                        <t t-foreach="o.payment_ids" t-as="p">
                            <tr><td><span t-esc="p.payment_method_id.name"/></td>
                                <td class="text-end"><span t-esc="p.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td></tr>
                        </t>
                    </table>
                    <hr/>
                    <div class="text-center">Thank you for visiting!</div>
                </div>
            </t>
        </t>
    </template>
</odoo>
